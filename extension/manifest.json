{
  "manifest_version": 3,
  "name": "meetnote",
  "version": "0.4.0",
  "description": "툴바 아이콘으로 meetnote를 연다. 우클릭하면 지금 탭 위에 회의 녹음 패널을 띄운다.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "https://dab2n.github.io/meetnote/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "panel.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_title": "meetnote 열기 (우클릭: 녹음 패널)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
